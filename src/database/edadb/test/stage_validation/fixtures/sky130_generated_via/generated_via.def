VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN generated_via_fixture ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 50000 50000 ) ;

ROW ROW_0 unit 9600 9990 N DO 64 BY 1 STEP 480 0 ;

TRACKS X 185 DO 135 STEP 370 LAYER met1 ;
TRACKS Y 185 DO 135 STEP 370 LAYER met1 ;
TRACKS X 240 DO 104 STEP 480 LAYER met2 ;
TRACKS Y 240 DO 104 STEP 480 LAYER met2 ;
TRACKS X 370 DO 67 STEP 740 LAYER met3 ;
TRACKS Y 370 DO 67 STEP 740 LAYER met3 ;
TRACKS X 480 DO 52 STEP 960 LAYER met4 ;
TRACKS Y 480 DO 52 STEP 960 LAYER met4 ;
TRACKS X 185 DO 15 STEP 3330 LAYER met5 ;
TRACKS Y 185 DO 15 STEP 3330 LAYER met5 ;

VIAS 4 ;
- via_1600x480
  + VIARULE M1M2_PR_C
  + CUTSIZE 150 150
  + LAYERS met1 via met2
  + CUTSPACING 170 170
  + ENCLOSURE 85 85 85 85
  + ROWCOL 2 5
  ;
- via2_1600x480
  + VIARULE M2M3_PR_C
  + CUTSIZE 200 200
  + LAYERS met2 via2 met3
  + CUTSPACING 200 200
  + ENCLOSURE 85 140 100 65
  + ROWCOL 1 4
  ;
- via3_1600x480
  + VIARULE M3M4_PR_C
  + CUTSIZE 200 200
  + LAYERS met3 via3 met4
  + CUTSPACING 200 200
  + ENCLOSURE 100 90 65 140
  + ROWCOL 1 4
  ;
- via4_1600x1600
  + VIARULE M4M5_PR_C
  + CUTSIZE 800 800
  + LAYERS met4 via4 met5
  + CUTSPACING 800 800
  + ENCLOSURE 190 400 1008 310
  + ROWCOL 1 1
  ;
END VIAS

COMPONENTS 0 ;
END COMPONENTS

PINS 0 ;
END PINS

SPECIALNETS 1 ;
- VDD
  + USE POWER
  + ROUTED met2 0 + SHAPE STRIPE ( 10000 10000 ) via_1600x480
    NEW met3 0 + SHAPE STRIPE ( 20000 20000 ) via2_1600x480
    NEW met4 0 + SHAPE STRIPE ( 30000 30000 ) via3_1600x480
    NEW met4 0 + SHAPE STRIPE ( 40000 40000 ) via4_1600x1600
  ;
END SPECIALNETS

NETS 0 ;
END NETS

END DESIGN
